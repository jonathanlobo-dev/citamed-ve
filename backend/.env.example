# ===========================================
# CITAMED.VE - Backend Environment Variables
# ===========================================
# Copiar este archivo a .env y configurar valores

# Database Configuration (PostgreSQL)
DB_NAME=citamed_development
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# JWT Configuration
JWT_SECRET=your_super_secret_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=24h

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Redis Configuration (cache y sesiones)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=300

# Email Configuration (opcional - para verificacion)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# WhatsApp Business API (opcional - para notificaciones)
# WHATSAPP_API_TOKEN=your_whatsapp_token
# WHATSAPP_PHONE_ID=your_phone_id
